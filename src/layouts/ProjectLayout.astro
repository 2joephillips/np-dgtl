---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import { Fancybox } from "@fancyapps/ui";
import arrow from "../assets/icons/arrow.svg";
interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props as Props;

// Load all images inside the projects galleries and pick the current project's images
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/*/gallery/*",
  { eager: true },
);

// if there is a video folder, load the video as well
const videoModules = import.meta.glob<{ default: string }>(
  "/src/assets/projects/*/video/*",
  { eager: true },
);

const images = Object.entries(modules)
  .filter(([path]) =>
    path.includes(`/projects/${project.data.projectFolder}/gallery/`),
  )
  .map(([, m]) => m.default);

const videos = Object.entries(videoModules)
  .filter(([path]) =>
    path.includes(`/projects/${project.data.projectFolder}/video/`),
  )
  .map(([, m]) => m.default);
---

<Layout>
  <section class="py-20 max-w-4xl mx-auto space-y-8">
    <!-- Title -->
    <h1 class="text-5xl font-bold leading-tight">{project.data.title}</h1>
    <a
      href="/projects"
      class="flex flex-row items-center gap-2 text-lg font-medium underline"
    >
      <img
        src={arrow.src}
        alt="Back Arrow"
        class="rotate-180 aspect-square w-6"
      />
      Back to Projects
    </a>
    <!-- Summary -->
    {project.data.summary && <p>{project.data.summary}</p>}

    <!-- Videos -->
    {
      videos.length > 0 && (
        <div class="pt-8">
          <div class="space-y-6">
            {videos.map((video) => (
              <figure class="overflow-hidden rounded-2xl bg-black shadow-sm ring-1 ring-black/5">
                <div class="mx-auto w-full max-w-4xl">
                  <video
                    controls
                    playsinline
                    autoplay
                    muted
                    preload="metadata"
                    class="block h-auto max-h-[75vh] w-full rounded-2xl object-cover"
                    src={video}
                  />
                </div>
              </figure>
            ))}
          </div>
        </div>
      )
    }

    <!-- Gallery Grid with responsive masonry layout and row separators -->
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 pt-8 space-y-4">
      {
        images.map((img, index) => {
          const aspectRatio = img.width / img.height;
          const imagesPerRow = 3; // Divider after every 3 images on desktop
          const showDivider =
            (index + 1) % imagesPerRow === 0 && index + 1 !== images.length;

          return (
            <>
              <a
                href={img.src}
                data-fancybox="gallery"
                data-caption={project.data.title}
                class="group block overflow-hidden rounded-lg transition-transform duration-300 hover:scale-105 break-inside-avoid"
                style={{
                  aspectRatio: `${aspectRatio}`,
                }}
              >
                <img
                  src={img.src}
                  alt={project.data.title}
                  class="w-full h-full object-cover"
                />
              </a>
              {showDivider && (
                <div class="w-full h-px bg-gray-200 break-inside-avoid my-2" />
              )}
            </>
          );
        })
      }
    </div>
  </section>
</Layout>

<script>
  import { Fancybox } from "@fancyapps/ui";
  import "@fancyapps/ui/dist/fancybox/fancybox.css";

  // Initialize Fancybox on all elements with data-fancybox attribute
  Fancybox.bind("[data-fancybox]");
</script>
