---
import "../styles/global.css";
import icon from "../assets/icons/logo.svg";
import Nav from "../components/Nav.astro";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import { Fancybox } from "@fancyapps/ui";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>NP DGTL</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Header with Icon name and hamburger menu -->
    <header
      class="sticky flex items-center justify-between px-8 py-4 shadow-md"
    >
      <div class="flex items-center gap-2">
        <img src={icon.src} alt="NP DGTL Logo" class="h-20" />
      </div>
      <span class="text-2xl font-bold">NP DGTL</span>
      <nav>
        <button
          id="menu-button"
          class="bg-none border-none text-2xl cursor-pointer">☰</button
        >
      </nav>
    </header>

    <!-- Sidebar -->
    <div
      id="sidebar"
      class="fixed right-0 top-0 h-screen w-full shadow-lg transform translate-x-full transition-transform duration-300 ease-in-out z-50 bg-gray-400"
    >
      <button
        id="close-button"
        class="absolute top-4 right-4 text-2xl cursor-pointer">✕</button
      >
      <nav class="p-8 pt-16">
        <div class="flex justify-between gap-2 mb-8">
          <div class="text-5xl font-bold">
            <Nav />
          </div>

          <div>
            <h2 class="text-m font-medium mb-8">XXX-XXX-XXXX</h2>
            <h2 class="text-m font-medium mb-8">hello@npdgtl.com</h2>
          </div>
        </div>
      </nav>
    </div>

    <slot />

    <footer
      class="flex flex-col items-center justify-center p-4 bg-gray-300 mt-8"
    >
      <div class="w-full flex flex-row justify-between">
        <Nav />
      </div>
      <hr class="w-full border-t border-gray-400 mb-4" />
      <div class="w-full flex flex-col justify-end">
        <div class="flex justify-end mb-4">
          <h2 class="text-m font-medium mr-8 uppercase">
            <a
              href="https://www.instagram.com"
              target="_blank"
              rel="noopener noreferrer">instagram</a
            >
          </h2>
          <h2 class="text-m font-medium mr-8 uppercase">
            <a
              href="https://www.linkedin.com"
              target="_blank"
              rel="noopener noreferrer">linkedin</a
            >
          </h2>
        </div>
        <hr class="w-full border-t border-gray-400 mb-4 align-baseline" />
        <p class="flex justify-end items-center text-sm uppercase gap-2">
          &copy; {new Date().getFullYear()} NP-DGTL Durham <img
            src={icon.src}
            alt="NP DGTL Logo"
            class="h-10 rotate-25"
          /> North Carolina
        </p>
      </div>
    </footer>
    <script is:inline>
      Fancybox.bind("[data-fancybox='gallery']", {});
    </script>
  </body>
</html>

<style>
  html {
    height: 100%;
  }

  body {
    margin: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  footer {
    margin-top: auto;
  }
</style>

<script>
  const menuButton = document.getElementById("menu-button");
  const closeButton = document.getElementById("close-button");
  const sidebar = document.getElementById("sidebar");

  menuButton?.addEventListener("click", () => {
    sidebar?.classList.remove("translate-x-full");
  });

  closeButton?.addEventListener("click", () => {
    sidebar?.classList.add("translate-x-full");
  });

  // Close sidebar when clicking outside (on the main content)
  document.addEventListener("click", (e) => {
    if (!sidebar?.contains(e.target as Node) && e.target !== menuButton) {
      sidebar?.classList.add("translate-x-full");
    }
  });
</script>
