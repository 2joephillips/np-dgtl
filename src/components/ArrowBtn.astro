---
import Arrow from "../assets/icons/arrow.svg";

interface Props {
  label: string;
}

const { label } = Astro.props as Props;
---

<button>
  <div class="svg-wrapper-1">
    <div class="svg-wrapper">
      <Arrow class="h-5 w-5" />
    </div>
  </div>
  <p class="uppercase">{label}</p>
</button>

<style>
  button {
    color: black;
    padding: 0em 0.75em;
    padding-left: 0.9em;
    display: flex;
    align-items: center;
    border: black 1px solid;
    border-radius: 26px;
    overflow: hidden;
    transition: all 0.2s;
    cursor: pointer;
  }

  button span {
    display: block;
    margin-left: 0.3em;
    transition: all 0.3s ease-in-out;
  }

  button svg {
    display: block;
    transform-origin: center center;
    transition: transform 0.3s ease-in-out;
  }

  button:hover .svg-wrapper {
    animation: fly-1 0.6s ease-in-out infinite alternate;
  }

  button:hover svg {
    transform: translateX(0em) scale(1.1) rotate(20deg);
  }

  button:hover span {
    transform: translateX(0em);
  }

  button:active {
    transform: scale(0.95);
  }

  @keyframes fly-1 {
    from {
      transform: translateY(0.1em);
    }

    to {
      transform: translateY(-0.1em);
    }
  }
</style>
