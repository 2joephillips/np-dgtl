---
import { Image } from "astro:assets";
import pic1 from "../assets/scrolling_photos/230A7292.jpg";
import pic2 from "../assets/scrolling_photos/IMG_7234.jpg";
import pic3 from "../assets/scrolling_photos/IMG_7833.jpg";
---

<section class="relative bg-white m-10">
  <!-- Sticky Text Container -->
  <div class="sticky top-0 h-[70vh] z-10 pointer-events-none">
    <!-- Top-left text -->
    <h2
      class="absolute top-0 left-0 text-4xl md:text-6xl lg:text-7xl uppercase leading-tight tracking-tight bg-white/80"
    >
      photography. videography.
      <br />
      digital marketing.
    </h2>

    <!-- Bottom-right text -->
    <h2
      class="absolute bottom-0 right-0 text-3xl md:text-5xl lg:text-8xl uppercase leading-snug tracking-tight p-4 bg-white/80"
    >
      in durham
    </h2>
  </div>

  <!-- Image Group -->
  <div class="relative z-0">
    <div class="grid grid-cols-2 grid-rows-2 gap-4">
      <!-- First Image -->
      <div class="aspect-square flex justify-center items-center col-start-2">
        <Image
          alt="Photo of a cityscape at dusk"
          src={pic1}
          class="object-cover shadow-lg max-h-[45vh] md:max-h-full"
        />
      </div>

      <!-- Second Image -->
      <div class="aspect-square flex justify-center items-center row-start-2">
        <Image
          alt="Photo of a cityscape at dusk"
          src={pic2}
          class="object-cover object-top shadow-lg max-h-[75vh] md:max-h-full"
        />
      </div>

      <!-- Third Image -->
      <div
        class="aspect-square flex justify-center items-center row-start-2 col-start-2"
      >
        <Image
          alt="Photo of a cityscape at dusk"
          src={pic3}
          class="object-cover object-top shadow-lg max-h-[75vh] md:max-h-full"
        />
      </div>
    </div>
  </div>
</section>
