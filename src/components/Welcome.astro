---
import Info from "../components/Info.astro";
import HeroVideo from "../components/HeroVideo.astro";
import { getCollection } from "astro:content";
import ProjectsGrid from "./ProjectsGrid.astro";

const projects = await getCollection("projects");
---

<main class="">
  <!-- SECTION 1: Video -->
  <HeroVideo />

  <!-- SECTION 2: Sticky Text + Scrolling Images -->
  <Info />

  <!-- SECTION 3: Projects Grid -->
  <div class="flex flex-row justify-around">
    <h1 class="text-4xl font-bold uppercase">My Work</h1>
    <button class="uppercase"> All Projects </button>
  </div>

  <ProjectsGrid projects={projects} />
</main>
