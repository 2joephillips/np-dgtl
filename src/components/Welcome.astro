---
import Info from "../components/Info.astro";
import HeroVideo from "../components/HeroVideo.astro";
import { getCollection } from "astro:content";
import ProjectsGrid from "./ProjectsGrid.astro";

const projects = await getCollection("projects");
---

<main id="welcome-container">
  <!-- SECTION 1: Video -->
  <HeroVideo />

  <!-- SECTION 2: Sticky Text + Scrolling Images -->
  <Info />

  <!-- SECTION 3: Projects Grid -->
  <div class="flex flex-row justify-between">
    <h2 class="text-4xl font-bold mb-10">My Work</h2>
    <button class="btn rounded-2xl">All Projects</button>
  </div>

  <ProjectsGrid projects={projects} />
</main>
