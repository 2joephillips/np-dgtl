---
import Nav from "./Nav.astro";
import icon from "../assets/icons/logo.svg";
---

<footer class="flex flex-col items-center justify-center p-4 mt-8">
  <div class="w-full flex flex-row justify-between">
    <Nav />
  </div>
  <hr class="w-full border-t border-gray-400 mb-4" />
  <div class="w-full flex flex-col justify-end">
    <div class="flex justify-end mb-4">
      <h2 class="text-m font-medium mr-8 uppercase">
        <a
          href="https://www.instagram.com"
          target="_blank"
          rel="noopener noreferrer">instagram</a
        >
      </h2>
      <h2 class="text-m font-medium mr-8 uppercase">
        <a
          href="https://www.linkedin.com"
          target="_blank"
          rel="noopener noreferrer">linkedin</a
        >
      </h2>
    </div>
    <hr class="w-full border-t border-gray-400 mb-4 align-baseline" />
    <p class="inline-flex justify-end items-center text-sm gap-2">
      &copy; {new Date().getFullYear()}

      <!-- NP-DGTL Logo -->
      <span
        class="inline-flex items-center text-[12px] font-['Space_Grotesk'] font-bold tracking-[-0.02em]"
      >
        <span class="text-[#1F1F1F]">np</span>
        <span class="text-[#8A8A8A] mx-1">-</span>
        <span class="text-[#1F1F1F]">dgtl</span>
      </span>

      <!-- Location Text & Icon -->
      <span class="inline-flex items-center gap-1 uppercase">
        Durham, North Carolina
      </span>
    </p>
  </div>
</footer>
