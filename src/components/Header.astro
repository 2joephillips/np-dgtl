---
import icon from "../assets/icons/logo.svg";
import Nav from "../components/Nav.astro";
---

<header class="sticky flex items-center justify-between px-8 py-4 shadow-md">
  <div class="flex items-center gap-2">
    <img src={icon.src} alt="NP DGTL Logo" class="h-20" />
  </div>
  <h2 class="text-3xl font-bold">NP DGTL</h2>
  <nav>
    <button id="menu-button" class="bg-none border-none text-2xl cursor-pointer"
      >☰</button
    >
  </nav>
</header>

<!-- Sidebar -->

<div
  id="sidebar"
  class="fixed right-0 top-0 h-screen w-full shadow-lg transform
  translate-x-full transition-transform duration-300 ease-in-out z-50"
>
  <button
    id="close-button"
    class="absolute top-4 right-4 text-2xl cursor-pointer">✕</button
  >
  <nav class="p-8 pt-16">
    <div class="flex justify-between gap-2 mb-8">
      <div class="text-5xl font-bold">
        <Nav />
      </div>

      <div>
        <h2 class="text-m font-medium mb-8">XXX-XXX-XXXX</h2>
        <h2 class="text-m font-medium mb-8">hello@npdgtl.com</h2>
      </div>
    </div>
  </nav>
</div>
<script>
  const menuButton = document.getElementById("menu-button");
  const closeButton = document.getElementById("close-button");
  const sidebar = document.getElementById("sidebar");

  menuButton?.addEventListener("click", () => {
    sidebar?.classList.remove("translate-x-full");
  });

  closeButton?.addEventListener("click", () => {
    sidebar?.classList.add("translate-x-full");
  });

  // Close sidebar when clicking outside (on the main content)
  document.addEventListener("click", (e) => {
    if (!sidebar?.contains(e.target as Node) && e.target !== menuButton) {
      sidebar?.classList.add("translate-x-full");
    }
  });
</script>
