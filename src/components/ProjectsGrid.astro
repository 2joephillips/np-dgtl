---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props as Props;
---

<style>
  .rotate-svg {
    transform: rotate(180deg);
    transition: transform 0.3s ease;
    fill: black;
    background: white;
    border-radius: 50%;
    padding: 8px;
  }

  button:hover .rotate-svg {
    transform: rotate(90deg);
    fill: white;
    background: black;
  }
</style>

<section class="py-20 prose">
  <div class="flex flex-col decoration-gray-900">
    {
      projects.slice(0, 5).map((p) => (
        <div class="flex flex-row w-full px-5 items-stretch">
          <a href={`/projects/${p.slug}`} class="group">
            <div class=" overflow-hidden">
              <Image
                src={p.data.thumbnail}
                alt={p.data.title}
                class="aspect-9/16 h-100 w-75 object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
          </a>
          <div class="flex flex-col ml-5 w-full py-3 justify-around">
            <div class="flex flex-col gap-1">
              <h3 class="text-4xl md:text-6xl font-semibold">{p.data.title}</h3>
              <div class="grid grid-cols-2">
                <p class="text text-gray-600">{p.data.company}</p>
                <p class="text text-gray-600 text-right">{p.data.date}</p>
                <p class="text text-gray-600">{p.data.location}</p>
              </div>
            </div>
            <a
              href={`/projects/${p.slug}`}
              class="group overflow-hidden self-end"
            >
              <button
                class="btn btn-circle h-12 w-12 md:h-16 md:w-16 lg:h-20 lg:w-20"
                aria-label={`View project ${p.data.title}`}
              >
                <svg
                  class="rotate-svg w-full h-full"
                  data-bbox="65 42 70.708 116.667"
                  viewBox="0 0 200 200"
                  xmlns="http://www.w3.org/2000/svg"
                  data-type="shape"
                >
                  <g>
                    <path
                      d="m65 77.35 5.892 5.892 25.3-25.292v100.717h8.333V57.95l25.292 25.292 5.891-5.892L100.358 42 65 77.35Z"
                      fill-rule="evenodd"
                    />
                  </g>
                </svg>
              </button>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>
