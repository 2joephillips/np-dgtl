---
import introVideo from "../assets/intro_video/npdgtlwebintrovideo.mp4";
---

<section class="bg-black">
  <div class="container mx-auto px-4 max-w-4xl h-full">
    <video
      class="min-h-[60vh] md:min-h-[80vh] w-full aspect-video rounded-lg"
      autoplay
      muted
      playsinline
      loop
    >
      <source src={introVideo} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
  </div>
</section>
