---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import pic1 from "../assets/scrolling_photos/230A7292.jpg";
---

<Layout>
  <main class="p-10 flex-1">
    <section
      id="hero"
      class="max-w-6xl mx-auto px-6 py-20 flex flex-col-reverse lg:flex-row items-center gap-12"
    >
      <!-- Text Content -->
      <div class="flex-1 text-center lg:text-left">
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6"
        >
          👋 Hi, I'm Nick
        </h1>

        <p class="text-lg sm:text-xl text-gray-600 max-w-xl mx-auto lg:mx-0">
          I'm a freelance creative based in Durham, NC. Let me help you grow
          your brand and reach!

          <div class="mt-8">
            <a
              href="/contact"
              class="inline-block bg-black text-white px-6 py-3 rounded-lg text-sm font-semibold tracking-wide hover:bg-gray-800 transition"
            >
              Work With Me
            </a>
          </div>
        </p>

        <!-- Image -->
        <div class="flex-1 flex justify-center">
          <div
            class="bg-white p-4 pb-10 rounded-sm shadow-2xl -rotate-3 hover:rotate-0 transition duration-300"
          >
            <div class="w-72 sm:w-80 lg:w-96 aspect-square overflow-hidden">
              <Image
                alt="Photo of Nick"
                src={pic1}
                class="w-full h-full object-cover"
              />
            </div>

            <p
              class="mt-4 text-center text-sm font-medium tracking-wide text-gray-700"
            >
              Durham, NC
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
