---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main id="container" class="p-10">
    <section id="hero">
      <h1 class="text-4xl font-bold uppercase">say hello. 👋</h1>
      <p class="max-w-md mt-4 uppercase">
        We'd love to hear from you! Whether you have questions, feedback, or
        just want to connect, feel free to reach out to us.
      </p>
    </section>

    <section id="links" class="mt-8 flex flex-row gap-4 justify-end">
      <div id="social" class="flex flex-col">
        <h2 class="mr-4 uppercase">Social</h2>
        <a
          href="https://www.instagram.com/nick.dgtl/"
          target="_blank"
          rel="noopener noreferrer"
          class="mr-4 lowercase">instagram</a
        >
        <a
          href="
          https:
          www.linkedin.com
          in
          nicholas-phillips1234
          "
          target="_blank"
          rel="noopener noreferrer"
          class="mr-4 lowercase">LinkedIn</a
        >
        <a
          href="https://www.youtube.com/@nick_dgtl"
          target="_blank"
          rel="noopener noreferrer"
          class="mr-4 lowercase">YouTube</a
        >
      </div>
      <div id="social" class="flex flex-col">
        <h2 class="mr-4 uppercase">contact</h2>
        <a
          href="mailto:hello@npdgtl.com"
          target="_blank"
          rel="noopener noreferrer"
          class="mr-4">hello@npdgtl.com</a
        >
      </div>
    </section>
  </main>
</Layout>
