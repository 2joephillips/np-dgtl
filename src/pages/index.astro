---
import Layout from "../layouts/Layout.astro";
import Info from "../components/Info.astro";
import HeroVideo from "../components/HeroVideo.astro";
import { getCollection } from "astro:content";
import ProjectsGrid from "../components/ProjectsGrid.astro";

const projects = await getCollection("projects");
const featuredProjects = projects
  .sort((a, b) => {
    return b.data.order - a.data.order;
  })
  .slice(0, 4);
---

<Layout>
  <!-- SECTION 1: Video -->
  <HeroVideo />

  <!-- SECTION 2: Sticky Text + Scrolling Images -->
  <Info />

  <!-- SECTION 3: Projects Grid -->
  <div class="flex flex-row justify-around">
    <h1 class="text-4xl font-bold uppercase">My Work</h1>
    <a href="/work/">
      <button class="uppercase underline cursor-pointer"> All Projects </button>
    </a>
  </div>
  <ProjectsGrid projects={featuredProjects} />
</Layout>
