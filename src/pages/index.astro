---
import Layout from "../layouts/Layout.astro";
import Info from "../components/Info.astro";
import HeroVideo from "../components/HeroVideo.astro";
import { getCollection } from "astro:content";
import ProjectsGrid from "../components/ProjectsGrid.astro";

const projects = await getCollection("projects");
const featuredProjects = projects
  .sort((a, b) => {
    return b.data.order - a.data.order;
  })
  .slice(0, 4);
---

<Layout>
  <!-- SECTION 1: Video -->
  <HeroVideo />

  <!-- SECTION 2: Sticky Text + Scrolling Images -->
  <Info />

  <!-- SECTION 3: Projects Grid -->
  <div class="flex flex-row justify-between items-center mx-2">
    <p class="uppercase">My Work</p>
    <a href="/projects/">
      <button class="uppercase cursor-pointer"> All Projects </button>
    </a>
  </div>
  <ProjectsGrid projects={featuredProjects} />
</Layout>
